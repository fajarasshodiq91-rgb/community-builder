# Community Builder — Environment Variables Example
# Copy this file to .env.local to configure live Discord or Claude integrations.

# ----------------------------------------------------
# Discord Bot Credentials (Required only for LIVE setup)
# ----------------------------------------------------
# 1. Create an Application at: https://discord.com/developers/applications
# 2. Go to "Bot" tab -> Reset Token -> Copy Bot Token
# 3. Enable Bot Permissions: "Manage Channels", "Manage Roles", "View Channels"
# 4. Invite Bot to your server with OAuth2 URL Generator (scope: "bot", bot permissions: Manage Channels, Manage Roles)
DISCORD_BOT_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Default Discord Guild / Server ID for quick testing (Optional)
DISCORD_GUILD_ID=

# ----------------------------------------------------
# Telegram Bot Credentials (Required for Telegram Topics)
# ----------------------------------------------------
# 1. Chat with @BotFather on Telegram -> /newbot -> Copy Token
# 2. Create a Supergroup with "Topics" enabled
# 3. Add your Bot as Administrator with "Manage Topics" permission
# 4. Get Chat ID (e.g. -100xxxxxxxxxx) using @RawDataBot or group link
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----------------------------------------------------
# AI Service (Optional — Claude API for Phase 2 LLM)
# ----------------------------------------------------
ANTHROPIC_API_KEY=

# ----------------------------------------------------
# Database / Auth (Optional — Supabase when persistence is enabled)
# ----------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
